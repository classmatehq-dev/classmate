# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real secrets.

# --- Database (Neon Postgres) ---------------------------------------------
# From the Neon dashboard: Connection Details -> "Pooled connection" string.
DATABASE_URL=

# --- Auth ----------------------------------------------------------------
# Local dev: set to 1 to run without Clerk (fake local session). Never use in prod.
AUTH_DEV_BYPASS=1

# From the Clerk dashboard -> API keys. Leave blank while AUTH_DEV_BYPASS=1.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
